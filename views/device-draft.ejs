<%- include('layout') %>

<div class="draft-container">
    <h1 class="page-title">Добавление прибора</h1>
    
    <% if (device) { %>
    <form action="/devices" method="POST" class="device-form">
        <div class="form-section">
            <h3>Изображения</h3>
            <div class="media-upload">
                <label for="image">Изображение прибора:</label>
                <input type="file" id="image" name="image" accept="image/*">
                <img src="<%= device.imageUrl %>" alt="Preview" class="preview-image">
            </div>
            <div class="media-upload">
                <label for="video">Видео прибора:</label>
                <input type="file" id="video" name="video" accept="video/*">
            </div>
        </div>
        
        <div class="form-section">
            <h3>Информация о приборе</h3>
            <label for="deviceName">Название прибора:</label>
            <input type="text" id="deviceName" name="deviceName" value="<%= device.deviceName %>" required>
            
            <label for="deviceType">Тип устройства:</label>
            <input type="text" id="deviceType" name="deviceType" value="<%= device.deviceType %>" required>
            
            <label for="powerConsumption">Мощность (Вт):</label>
            <input type="number" id="powerConsumption" name="powerConsumption" value="<%= device.powerConsumption %>" required>
            
            <label for="frequencyRange">Частотный диапазон:</label>
            <input type="text" id="frequencyRange" name="frequencyRange" value="<%= device.frequencyRange %>" required>
            
            <label for="emfLevel">Уровень ЭМП (мкВт/см²):</label>
            <input type="number" id="emfLevel" name="emfLevel" step="0.1" value="<%= device.emfLevel %>" required>
            
            <label for="safetyDistance">Безопасное расстояние (м):</label>
            <input type="number" id="safetyDistance" name="safetyDistance" step="0.1" value="<%= device.safetyDistance %>" required>
            
            <label for="description">Описание:</label>
            <textarea id="description" name="description" rows="3"><%= device.description %></textarea>
        </div>
        
        <button type="submit" class="btn-primary">Далее</button>
    </form>
    <% } else { %>
    <p>Нет прибора в статусе черновик</p>
    <button class="btn-primary">Создать новый прибор</button>
    <% } %>
</div>
