<%- include('layout') %>

<% if (device) { %>
<div class="feed-container">
    <div class="video-feed">
        <video autoplay loop muted class="feed-video">
            <source src="<%= device.videoUrl %>" type="video/mp4">
            Ваш браузер не поддерживает видео
        </video>
        
        <div class="feed-overlay">
            <h2 class="feed-title"><%= device.deviceName %></h2>
            <p class="feed-type"><%= device.deviceType %></p>
            
            <div class="feed-params">
                <span>Мощность: <%= device.powerConsumption %> Вт</span>
                <span>ЭМП: <%= device.emfLevel %> мкВт/см²</span>
                <span>Безопасное расстояние: <%= device.safetyDistance %> м</span>
                <span>Частота: <%= device.frequencyRange %></span>
            </div>
            
            <div class="feed-description">
                <p class="description-text"><%= device.description %></p>
            </div>
            
            <div class="feed-actions">
                <button class="like-button">❤️ <%= device.likesCount || 0 %></button>
                <a href="/devices/<%= device.id %>?next=true" class="next-button">Следующий →</a>
            </div>
        </div>
    </div>
</div>
<% } else { %>
<div class="not-found">
    <h2>Прибор не найден</h2>
    <p>Возможно, он был удален или не существует</p>
</div>
<% } %>
